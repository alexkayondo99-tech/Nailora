<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nailora | Luxury Nail Booking</title>

<style>

*{box-sizing:border-box;margin:0;padding:0}

body{font-family:Arial,sans-serif;background:#faf8f5;color:#241d1a}

header{display:flex;justify-content:space-between;align-items:center;padding:20px 6%;background:#faf8f5}

.logo{font-family:Georgia,serif;font-size:30px}

nav{display:flex;gap:20px;align-items:center}

nav a{color:#241d1a;text-decoration:none}

.menu-btn{display:none;border:1px solid #ddd;background:none;padding:12px;border-radius:50%;font-size:22px}

.hero{padding:100px 6%;min-height:550px;background:linear-gradient(rgba(35,25,20,.45),rgba(35,25,20,.55)),url('https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1600&q=80') center/cover;color:white}

.hero small{letter-spacing:5px}

.hero h1{font-family:Georgia,serif;font-size:clamp(40px,8vw,75px);font-weight:normal;margin:20px 0}

.hero p{font-size:18px;line-height:1.7;max-width:600px}

.searchbox{margin-top:30px;background:white;border-radius:18px;padding:15px;display:flex;flex-wrap:wrap;gap:10px;max-width:700px}

.searchbox input{flex:1;min-width:180px;padding:15px;border:1px solid #ddd;border-radius:10px;font-size:16px}

button,.btn{background:#241d1a;color:white;border:0;padding:15px 22px;border-radius:30px;cursor:pointer;text-decoration:none}

.searchbox button{width:100%}

section{padding:60px 6%}

h2{text-align:center;font-family:Georgia,serif;font-size:36px;font-weight:normal;margin-bottom:15px}

.sub{text-align:center;color:#777;margin-bottom:30px}

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}

.card{background:white;border-radius:15px;overflow:hidden;box-shadow:0 4px 15px #00000008}

.card img{width:100%;height:250px;object-fit:cover}

.card h3{padding:15px}

.card p{padding:0 15px 15px;color:#777}

.card .btn{display:inline-block;margin:0 15px 18px}

.artist{background:white;padding:25px;border-radius:15px;margin:12px 0}

.artist p{margin:10px 0;color:#777}

.formbox{max-width:600px;margin:auto;background:white;padding:25px;border-radius:18px}

form input,form select,form textarea{width:100%;padding:14px;margin:10px 0;border:1px solid #ddd;border-radius:10px;font-size:16px}

form button{width:100%;margin-top:10px}

footer{text-align:center;background:#241d1a;color:white;padding:30px}

.mobile-nav{display:none}

@media(max-width:700px){

header{padding:18px 5%}

.menu-btn{display:block}

nav{display:none;position:absolute;top:75px;left:0;width:100%;background:#faf8f5;z-index:20;flex-direction:column;align-items:stretch;gap:0;padding:10px 5%;box-shadow:0 8px 20px #0001}

nav.open{display:flex}

nav a{padding:18px 10px;border-bottom:1px solid #eee;font-size:18px}

.hero{padding:75px 5%;min-height:600px}

.hero h1{font-size:48px}

.hero p{font-size:17px}

.searchbox{flex-direction:column}

.searchbox input{width:100%}

.grid{grid-template-columns:1fr}

section{padding:45px 5%}

.card img{height:280px}

.mobile-nav{display:flex;position:fixed;bottom:0;left:0;width:100%;background:#faf8f5;border-top:1px solid #ddd;justify-content:space-around;padding:12px 5%;z-index:30}

.mobile-nav a{color:#8b5c52;text-decoration:none;text-align:center;font-size:13px}

.mobile-nav span{display:block;font-size:22px;margin-bottom:5px}

body{padding-bottom:80px}

}

</style>

</head>

<body>

<header>

<div class="logo">Nailora <span style="color:#9b5b50">.</span></div>

<button class="menu-btn" onclick="toggleMenu()">☰</button>

<nav id="menu">

<a href="#home" onclick="closeMenu()">Home</a>

<a href="#designs" onclick="closeMenu()">Designs</a>

<a href="#artists" onclick="closeMenu()">Find an artist</a>

<a href="#technicians" onclick="closeMenu()">For technicians</a>

<a href="#booking" onclick="closeMenu()">Book now</a>

</nav>

</header>

<div class="hero" id="home">

<small>LUXURY NAIL BOOKING</small>

<h1>Beautiful nails,<br><i>beautifully booked.</i></h1>

<p>Discover stunning designs and book talented nail artists in your city.</p>

<div class="searchbox">

<input id="city" placeholder="City or neighborhood">

<input id="service" placeholder="Gel, acrylic, artist name...">

<button onclick="searchArtists()">Search artists</button>

</div>

</div>

<section id="designs">

<h2>Discover nail designs</h2>

<p class="sub">Find your next nail inspiration.</p>

<div class="grid">

<div class="card">

<img src="https://images.unsplash.com/photo-1610992015732-2449b763bcd5?auto=format&fit=crop&w=800&q=80">

<h3>Elegant nails</h3>

<p>Beautiful everyday nail inspiration.</p>

<a class="btn" href="#booking">Book this style</a>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80">

<h3>Luxury manicure</h3>

<p>Discover modern luxury nail looks.</p>

<a class="btn" href="#booking">Book this style</a>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=800&q=80">

<h3>Creative nails</h3>

<p>Explore beautiful nail art.</p>

<a class="btn" href="#booking">Book this style</a>

</div>

</div>

</section>

<section id="artists">

<h2>Find a nail artist</h2>

<p class="sub">Discover talented nail technicians near you.</p>

<div id="artistResults">

<div class="artist">

<h3>Find your nail technician</h3>

<p>Search by city, service or artist name using the search box above.</p>

<a class="btn" href="#booking">Make a booking request</a>

</div>

</div>

</section>

<section id="technicians">

<h2>Are you a nail technician?</h2>

<p class="sub">Join Nailora and let clients discover your work.</p>

<div class="formbox">

<form onsubmit="registerArtist(event)">

<input id="artistName" placeholder="Your full name" required>

<input id="artistCity" placeholder="Your city" required>

<input id="artistPhone" placeholder="Phone number" required>

<input id="artistService" placeholder="Services you offer" required>

<textarea id="artistAbout" placeholder="Tell clients about your work"></textarea>

<button type="submit">Submit registration</button>

</form>

</div>

</section>

<section id="booking">

<h2>Request a booking</h2>

<p class="sub">Send a booking request to a nail artist.</p>

<div class="formbox">

<form onsubmit="bookAppointment(event)">

<input id="clientName" placeholder="Your name" required>

<input id="clientPhone" placeholder="Your phone number" required>

<input id="bookingCity" placeholder="City" required>

<input id="bookingService" placeholder="Service you want" required>

<input id="bookingDate" type="date" required>

<textarea id="bookingNotes" placeholder="Additional details"></textarea>

<button type="submit">Send booking request</button>

</form>

</div>

</section>

<footer>

<p>Nailora — Beautiful nails, beautifully booked.</p>

<p style="margin-top:10px">Discover. Book. Beauty.</p>

</footer>

<div class="mobile-nav">

<a href="#home"><span>⌂</span>Home</a>

<a href="#designs"><span>✧</span>Designs</a>

<a href="#artists"><span>⌕</span>Find</a>

<a href="#booking"><span>▣</span>Bookings</a>

</div>

<script>

function toggleMenu(){

document.getElementById('menu').classList.toggle('open');

}

function closeMenu(){

document.getElementById('menu').classList.remove('open');

}

function searchArtists(){

let city=document.getElementById('city').value;

let service=document.getElementById('service').value;

document.getElementById('artists').scrollIntoView({behavior:'smooth'});

document.getElementById('artistResults').innerHTML=

'<div class="artist"><h3>Search results</h3><p>Location: '+(city||'Any city')+'</p><p>Service: '+(service||'Any service')+'</p><p>Nail artist listings will be available as technicians join Nailora.</p><a class="btn" href="#technicians">Join as a technician</a></div>';

}

function registerArtist(e){

e.preventDefault();

alert('Your registration form is ready. Online registration storage will be connected in a future development step.');

}

function bookAppointment(e){

e.preventDefault();

alert('Your booking form is ready. Online booking and confirmation system will be connected in a future development step.');

}

</script>

</body>

</html>