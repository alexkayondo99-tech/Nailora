<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nailora | Nail Beauty</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#fffaf8;color:#292329}
header{padding:22px;background:#fff;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:27px;font-weight:bold;color:#9b5477}
nav a{margin-left:12px;text-decoration:none;color:#333;font-size:14px}
.hero{padding:55px 24px;background:#f3e3ea;text-align:center}
.hero h1{font-size:38px;margin-bottom:15px;color:#713d59}
.hero p{font-size:17px;margin-bottom:22px}
.btn{background:#9b5477;color:white;padding:14px 22px;border:none;border-radius:8px;text-decoration:none;display:inline-block}
section{padding:35px 20px}
h2{text-align:center;margin-bottom:24px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.card{background:white;border-radius:12px;overflow:hidden;box-shadow:0 2px 10px #0001}
.card img{width:100%;height:180px;object-fit:cover}
.card h3{padding:12px 10px 5px}
.card p{padding:0 10px 14px;color:#777}
form{max-width:500px;margin:auto}
input,select,textarea{width:100%;padding:14px;margin:9px 0;border:1px solid #ddd;border-radius:8px;font-size:16px}
form button{width:100%;cursor:pointer}
footer{text-align:center;padding:25px;background:#292329;color:white}
</style>
</head>
<body>

<header>
<div class="logo">Nailora</div>
<nav>
<a href="#designs">Designs</a>
<a href="#booking">Book</a>
</nav>
</header>

<div class="hero">
<h1>Beauty at Your Fingertips</h1>
<p>Discover beautiful nail designs and book your nail artist.</p>
<a class="btn" href="#booking">Book an Appointment</a>
</div>

<section id="designs">
<h2>Discover Nail Designs</h2>
<div class="grid">

<div class="card">
<img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=600&q=80">
<h3>Elegant Nails</h3>
<p>Timeless beauty</p>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1610992015732-2449b7630a4c?auto=format&fit=crop&w=600&q=80">
<h3>Modern Nails</h3>
<p>Trending styles</p>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=600&q=80">
<h3>Creative Nails</h3>
<p>Express yourself</p>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1619946645028-9f2f9e1f1f1f?auto=format&fit=crop&w=600&q=80">
<h3>Luxury Nails</h3>
<p>Beauty and elegance</p>
</div>

</div>
</section>

<section id="booking">
<h2>Book an Appointment</h2>
<form id="bookingForm">
<input id="name" placeholder="Your full name" required>
<input id="phone" placeholder="Your phone number" required>
<select id="service" required>
<option value="">Select nail service</option>
<option>Manicure</option>
<option>Pedicure</option>
<option>Gel Nails</option>
<option>Acrylic Nails</option>
<option>Nail Art</option>
</select>
<input id="date" type="date" required>
<textarea id="message" placeholder="Additional details"></textarea>
<button class="btn" type="submit">Send Booking Request</button>
</form>
</section>

<footer>
<p>© 2026 Nailora</p>
<p>Discover. Choose. Book.</p>
</footer>

<script>
document.getElementById("bookingForm").addEventListener("submit",function(e){
e.preventDefault();
let text="Hello Nailora, I want to book an appointment.%0A"+
"Name: "+document.getElementById("name").value+"%0A"+
"Phone: "+document.getElementById("phone").value+"%0A"+
"Service: "+document.getElementById("service").value+"%0A"+
"Date: "+document.getElementById("date").value+"%0A"+
"Details: "+document.getElementById("message").value;
window.open("https://wa.me/?text="+text,"_blank");
});
</script>

</body>
</html>
